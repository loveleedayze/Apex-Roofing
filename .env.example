# Maggie Mae, the AI receptionist. Leave blank to run in DEMO mode (rule-based
# canned replies). Set it to make Maggie a real Claude-powered receptionist.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Leave these blank to run in DEMO mode (leads are logged, not sent).
# Fill any of them to fan real leads out to that CRM's inbound webhook.
JOBNIMBUS_WEBHOOK_URL=
ACCULYNX_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Voice layer — Maggie answers the phone (Twilio)
# ---------------------------------------------------------------------------
# All optional. With none of these set the site behaves exactly as before;
# the /api/voice endpoints simply never get called.

# From https://console.twilio.com — Account SID and Auth Token on the dashboard.
# The auth token is what we use to VERIFY that inbound webhooks really came
# from Twilio. Without it the endpoints accept anyone who knows the URL, so
# treat it as required before pointing a real number at this app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio number callers dial, E.164 format, e.g. +15125550142.
# Informational — used for display and logs, not for answering.
TWILIO_PHONE_NUMBER=

# Public base URL of this deployment, e.g. https://apex-roofing-iota.vercel.app
# Twilio signs the exact URL it requested. Behind a proxy the URL we see can
# differ, which breaks signature checks — pin it here if verification fails.
TWILIO_WEBHOOK_BASE_URL=

# Which voice reads Maggie's lines. Amazon Polly neural voices sound the least
# robotic; see Twilio's TTS voice list for the full set.
# Defaults to Polly.Joanna-Neural.
TWILIO_VOICE=
TWILIO_LANGUAGE=

# ---------------------------------------------------------------------------
# Call session storage
# ---------------------------------------------------------------------------
# A phone call spans a dozen separate HTTP requests. On serverless those can
# land on different instances, so the transcript needs somewhere shared to
# live — otherwise Maggie forgets the conversation mid-call. Any Upstash Redis
# or Vercel KV database works; free tier is plenty.
# Without these, sessions are kept in memory: fine for local testing, not for
# a real phone line.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Browser voice widget (components/MaggieCall.tsx)
# ---------------------------------------------------------------------------
# Which engine the floating call widget uses: browser | demo | vapi | retell
#
# "browser" runs real calls on the browser's own speech engines — no vendor,
# no account, no per-minute cost. It needs ANTHROPIC_API_KEY (the thinking
# happens at /api/voice/turn) and HTTPS in production. Chrome, Edge and Safari
# support it; Firefox does not, and the widget says so there. Note that Chrome
# implements speech recognition by streaming mic audio to Google, so mention it
# on the privacy page if the client's customers would care.
#
# "demo" (the default) runs a local simulation with no credentials, so the
# widget is always demonstrable. It is labelled as a simulation in the UI.
NEXT_PUBLIC_VOICE_PROVIDER=demo

# Which language Maggie opens a browser call in: en (default) | es
# She follows the caller after the first sentence either way — this only sets
# the greeting. Worth flipping to es for a predominantly Spanish-speaking book
# of business.
NEXT_PUBLIC_VOICE_OPEN_IN=en

# Vapi (vapi.ai) — publishable key, safe in the browser.
# Also run: npm install @vapi-ai/web  and uncomment loadSdk in lib/voiceClient.ts
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Retell AI (retellai.com) — the API key is SERVER-SIDE ONLY. It must never be
# NEXT_PUBLIC_; the browser gets a per-call token from /api/voice/web-session.
# Also run: npm install retell-client-js-sdk
RETELL_API_KEY=
RETELL_AGENT_ID=
